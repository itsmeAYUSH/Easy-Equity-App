# EasyEquity mobile — copy to .env.local for local development.
# Only EXPO_PUBLIC_* values reach the app, and every one of them ships inside the
# binary: never put a secret here. Secrets stay in the backend ("easyEquity server/.env").

# The same Express API the website uses (it owns the MongoDB database).
#   Production: https://easy-equity.onrender.com/api
#   Local API on your computer: http://<your-LAN-IP>:3001/api  (a phone can't reach "localhost")
# When unset, release builds use production and dev builds use the Metro host on port 3001.
EXPO_PUBLIC_API_URL=https://easy-equity.onrender.com/api

# The same Supabase project the website signs in with (public URL + publishable/anon key).
EXPO_PUBLIC_SUPABASE_URL=https://zxlszrmkgywpndytkjyp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_sTBpDe_HKtMxcpRX8K3j9A_Sl-GzSFY

# The website, for links that open in the browser (pricing, legal pages).
EXPO_PUBLIC_SITE_URL=https://www.easyequity.in.net
